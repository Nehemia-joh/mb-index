# Copy of the real .envmb-index file.
# IMPORTANT: .envmb-index does NOT live inside this project folder — it is kept
# ONE STEP BEHIND it (e.g. when this project lives in /home/user/Gilliam, the
# .envmb-index lives in /home/user/.envmb-index) so it is never web-accessible.
# config.php automatically loads ../.envmb-index

APP_NAME=Maisha Bora Autism Rating Scale
APP_ENV=production

# --- Database (MySQL only) ---------------------------------------------------
# DB_NAME/DB_USER/DB_PASS: the values cPanel gives you when you create
# the database and user.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_cpanel_db_name
DB_USER=your_cpanel_db_user
DB_PASS=your_cpanel_db_password
DB_CHARSET=utf8mb4

DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_EMAIL=you@yourdomain.tz
DEFAULT_ADMIN_PASSWORD=change-this-in-production
DEFAULT_ADMIN_ROLE=it_admin

SESSION_TIMEOUT=7200
